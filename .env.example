# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://postgres:Your_password@localhost:5432/trafficvision

# ---- Auth ----
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES_MIN=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# ---- TomTom APIs ----
# Get a free key at https://developer.tomtom.com/
TOMTOM_API_KEY=Your_APT_key

# ---- App ----
FLASK_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
